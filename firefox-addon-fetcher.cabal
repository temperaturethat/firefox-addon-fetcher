cabal-version: 3.0
name: firefox-addon-fetcher
version: 0.1.0.0
synopsis: Generate Firefox extension metadata as JSON Lines
category: Web
build-type: Simple
license: GPL-3.0-only
license-file: LICENSE
author: thattemperature
maintainer: that.temperature@mail.com
description:
  Query Mozilla Add-ons for selected Firefox extensions or discover extensions
  through paginated, partitioned searches. Emit a validated JSON Lines snapshot
  with retry handling and atomic publication. XPI packaging belongs to Nix.
extra-doc-files:
  README.md
  CHANGELOG.md
  CONTRIBUTING.md
  docs/architecture.md
  docs/jsonl-schema.md
  docs/conventions.md
  docs/testing.md
extra-source-files:
  cabal.project
  flake.nix
  flake.lock
  fourmolu.yaml
  .editorconfig
  test/fixtures/README.md
data-files: test/fixtures/amo-page.json

flag strict
  description: Treat compiler warnings as errors for development and CI
  default: False
  manual: True

common warnings
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  if flag(strict)
    ghc-options: -Werror

library
  import: warnings
  hs-source-dirs: src
  exposed-modules:
    FirefoxAddons.Model
    FirefoxAddons.Discover
    FirefoxAddons.Generate
    FirefoxAddons.Http
    FirefoxAddons.Retry
    FirefoxAddons.JsonLines
    FirefoxAddons.Publish
  build-depends:
    base >=4.20 && <4.22,
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    containers >=0.7 && <0.9,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    http-client >=0.7 && <0.8,
    http-conduit >=2.3 && <2.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15,
    transformers >=0.6 && <0.7

executable addon-fetcher
  import: warnings
  hs-source-dirs: app
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  build-depends:
    base >=4.20 && <4.22,
    aeson >=2.2 && <2.3,
    firefox-addon-fetcher,
    text >=2.1 && <2.2

test-suite fetcher-tests
  import: warnings
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -threaded -rtsopts
  other-modules:
    FirefoxAddons.ModelSpec
    FirefoxAddons.DiscoverSpec
    FirefoxAddons.GenerateSpec
    FirefoxAddons.HttpSpec
    FirefoxAddons.RetrySpec
    FirefoxAddons.JsonLinesSpec
    FirefoxAddons.PublishSpec
    FirefoxAddons.IntegrationSpec
    FirefoxAddons.Properties
    Support.Http
    Support.Temp
    Paths_firefox_addon_fetcher
  autogen-modules: Paths_firefox_addon_fetcher
  build-depends:
    base >=4.20 && <4.22,
    aeson >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    directory >=1.3 && <1.4,
    filepath >=1.5 && <1.6,
    firefox-addon-fetcher,
    http-client >=0.7 && <0.8,
    network >=3.2 && <3.3,
    tasty >=1.5 && <1.6,
    tasty-hunit >=0.10 && <0.11,
    tasty-quickcheck >=0.11 && <0.12,
    temporary >=1.3 && <1.4,
    text >=2.1 && <2.2,
    time >=1.12 && <1.15
